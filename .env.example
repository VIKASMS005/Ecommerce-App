# Copy this file to .env and replace the values with your own API keys.
# KEEP SENSITIVE KEYS OUT OF SOURCE CONTROL. Do NOT commit `.env`.

# Google Maps API key (for Maps SDK and Places)
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# Firebase API keys (project-specific). You can obtain these from your
# Firebase Console -> Project settings -> General -> Your apps
FIREBASE_API_KEY_WEB=YOUR_FIREBASE_API_KEY_WEB_HERE
FIREBASE_API_KEY_ANDROID=YOUR_FIREBASE_API_KEY_ANDROID_HERE
FIREBASE_API_KEY_IOS=YOUR_FIREBASE_API_KEY_IOS_HERE
FIREBASE_API_KEY_MACOS=YOUR_FIREBASE_API_KEY_MACOS_HERE
FIREBASE_API_KEY_WINDOWS=YOUR_FIREBASE_API_KEY_WINDOWS_HERE

# Example:
# GOOGLE_API_KEY=AIzaSyXXXXXXXXXXXX
# FIREBASE_API_KEY_ANDROID=AIzaSyYYYYYYYYYYYY
